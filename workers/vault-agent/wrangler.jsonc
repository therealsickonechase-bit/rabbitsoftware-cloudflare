{
  "name": "rabbitsoftware-vault-agent",
  "account_id": "f78fa7ea6c63f95d9512053554416e32",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "VAULT", "bucket_name": "rabbitsoftware-vault-agent" }],
  "workflows": [{ "binding": "JOBS", "name": "rabbitsoftware-vault-jobs", "class_name": "VaultJob" }],
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "VaultBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VaultBudget"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
