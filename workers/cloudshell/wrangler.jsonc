{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rabbitsoftware-cloudshell",
  "account_id": "f78fa7ea6c63f95d9512053554416e32",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": { "required": ["RABBIT_CLOUDSHELL_TOKEN", "RABBIT_AGENT_APPROVAL_TOKEN"] },
  "vars": {
    "RABBIT_CLOUD_ACCESS_SUBJECTS": "[\"email:ringquistchase@gmail.com\",\"agent:local-vault-agent\"]",
    "RABBIT_CLOUD_AGENT_SCOPES": "[\"shell.execute\",\"vault.submit\",\"vault.read\"]"
  },
  "containers": [{
    "class_name": "Sandbox",
    "image": "./Dockerfile",
    "max_instances": 2,
    "instance_type": "lite"
  }],
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX", "class_name": "Sandbox" },
      { "name": "COMMAND_GATE", "class_name": "CommandGate" },
      { "name": "ACCESS_GATE", "class_name": "AccessGate" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sandbox", "CommandGate", "AccessGate"] }],
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
