{
  // STAGING Worker for the GCP terminal backend. Separate name, separate Durable Objects and quotas, workers.dev only, NO containers, NO routes:
  // the live guest shell (wrangler.jsonc, rabbitsoftware-public-shell) is untouched. Used by Setup-GcpShellStaging.ps1 and the end-to-end smoke test.
  // Its Turnstile secret is Cloudflare's published "always passes" TEST key, so a script can open sessions; it must never be used for the real page.
  "name": "rabbitsoftware-public-shell-gcp-test",
  "account_id": "f78fa7ea6c63f95d9512053554416e32",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PUBLIC_SHELL_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://app.rabbitsoftware.io",
    "TERMINAL_BACKEND": "gcp",
    "GCP_SHELL_URL": "https://rabbit-visitor-shell-vxx5lz7c5a-wl.a.run.app"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX", "class_name": "PublicSandbox" },
      { "name": "GATE", "class_name": "Gate" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PublicSandbox", "Gate"] }],
  "observability": { "enabled": true }
}
